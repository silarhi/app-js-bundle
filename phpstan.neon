parameters:
    level: max
    paths:
        - src
        - tests
    # Typed class constants need PHP 8.3, the bundle supports 8.2: a non-ignorable error
    excludePaths:
        - tests/Fixtures/TypedConstants
    tmpDir: var/tools/phpstan
    ignoreErrors:
        # the config tree validates $config: its shape is narrowed by an inline @var, the parent signature allows no @param
        -
            identifier: missingType.iterableValue
            path: src/SilarhiAppJsBundle.php
            message: '#loadExtension#'
            count: 1
